# =============================================================================
# 10th Meridian — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# The app is designed to boot in preview/demo mode when live keys are absent.
# =============================================================================

# --- Runtime mode -------------------------------------------------------------
# preview  = stubs + synthetic DEMO data (safe for review; default)
# live     = require real integrations (still do not deploy from this PR)
NEXT_PUBLIC_RUNTIME_MODE=preview

# Show discreet reviewer tools (Preview as Member / Open House force helpers).
# MUST be false in any production environment.
NEXT_PUBLIC_PREVIEW_TOOLS=true
# Demo lock sessions without live passwords. MUST be false in Production.
# The closed-lock username → password / referral form stays visible either way.
PREVIEW_DEMO_AUTH=true

# --- Site ---------------------------------------------------------------------
# Public origin for referral links, QR, and metadata.
# On Vercel, leave these blank to use the current https://$VERCEL_URL.
# Do not leave NEXT_PUBLIC_SITE_URL=http://localhost:3000 in a shared preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_NAME=10th Meridian
# Prepared domain (not purchased): tenmeridian.com

# --- Open House ---------------------------------------------------------------
# IANA timezone. Default America/Chicago. Admins can also persist this in
# site_config once Supabase is connected.
OPEN_HOUSE_TIMEZONE=America/Chicago
OPEN_HOUSE_DAY=10
OPEN_HOUSE_REFERRAL_HOUR=9
OPEN_HOUSE_GENERAL_HOUR=10
OPEN_HOUSE_CLOSE_HOUR=22

# auto | open | closed  — "auto" uses the visitor IANA timezone (cookie tm_tz /
# x-visitor-timezone). Invalid or missing TZ falls back to America/Chicago.
# Doors: 10:00–22:00 visitor local on the tenth. Referral early: 09:00 local.
# Use "open" or "closed" only for local/preview review. Never in production.
OPEN_HOUSE_FORCE=auto

# Monthly admissions cap (marketed as "no more than ten").
ADMISSIONS_MONTHLY_CAP=10

# --- Supabase (Auth + Postgres + Storage) ------------------------------------
# Leave empty to use in-process stubs. Build does not require these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (hosted Checkout + webhooks). Preview / TEST only. ----------------
# Store only Stripe IDs. Never collect or persist card data. Never commit secrets.
# Live keys (sk_live_ / rk_live_) are blocked unless Production + RUNTIME_MODE=live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# TEST catalog (acct_1UG1Kk3QQyESIKbf) — do not use the archived lifetime Price.
# Founding Ten entry $5,000 one_time
STRIPE_PRICE_FOUNDING_ENTRY=price_1UG1eB3QQyESIKbfGysIcPYf
# Standard entry $10,000 one_time (after Founding Ten, and every rejoin)
STRIPE_PRICE_STANDARD_ENTRY=price_1UG1eC3QQyESIKbfKbIfpHct
# Monthly dues $195/month (standard members only)
STRIPE_PRICE_MONTHLY=price_1UG1eD3QQyESIKbfZJOuoyS6
# Aliases
STRIPE_FOUNDING_PRICE_ID=
STRIPE_STANDARD_PRICE_ID=

# Retired — archived lifetime product. Do not set. Do not charge.
# STRIPE_PRICE_ID=price_1UG1Xg3QQyESIKbfV5BfJF6U
STRIPE_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=

NEXT_PUBLIC_FOUNDING_ENTRY_LABEL=$5,000
NEXT_PUBLIC_STANDARD_ENTRY_LABEL=$10,000
NEXT_PUBLIC_MONTHLY_DUES_LABEL=$195
FOUNDING_TEN_CAP=10
# Organization / Strategic Partnership is by application — no public price ID.

# --- Stream Chat --------------------------------------------------------------
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# --- Resend -------------------------------------------------------------------
# Authenticate domain tenmeridian.com (prepared, not purchased).
# From mailbox: team@tenmeridian.com
RESEND_API_KEY=
EMAIL_FROM=team@tenmeridian.com
# Alias kept for older checklists:
RESEND_FROM_EMAIL=10th Meridian <team@tenmeridian.com>
# Set after domain authentication. Do not send from an unverified domain.

# --- Embeddings / semantic matching (optional, pluggable) ---------------------
# When unset, matching uses a lexical/token fallback. Do not treat that as "AI".
EMBEDDING_PROVIDER=stub
# openai | stub
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Security -----------------------------------------------------------------
# Cookie signing for preview demo sessions and referral grants.
# Generate a long random string before any shared preview.
SESSION_SECRET=replace-with-a-long-random-string-before-shared-preview

# Rate-limit window (in-memory in preview; replace with Upstash/Redis in live).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REFERRAL_CHECKS=8
RATE_LIMIT_MAX_REMINDERS=5
RATE_LIMIT_MAX_APPLICATIONS=4

# Comma-separated emails that receive Open House reminder copies in live mode.
ADMIN_NOTIFICATION_EMAIL=

# --- PostHog (client analytics) ----------------------------------------------
# No-op when unset. Do not enable in Production from this PR.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (placeholders only) ----------------------------------------------
# Full SDK lives on PR #12 (cursor/sentry-nextjs-1166). Do not duplicate here.
# Paste a DSN later if that PR has not landed; this branch will not init Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
